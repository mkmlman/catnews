      "source": "hn",
      "title": "Show HN: Voice driven murder mystery, Interview AI suspects with your voice",
      "url": "https://www.whodunnitai.com/",
      "author": "MrRowTheBoat",
      "byline": "MrRowTheBoat",
      "external_id": "49238851",
      "summary": null,
