      "source": "hn",
      "title": "Neovim have a ~$800k Bitcoin donation sitting untouched since 2023",
      "url": "https://news.ycombinator.com/item?id=49738879",
      "author": "jakemanger",
      "external_id": "49738879",
      "summary": null,
      "why_read": null,
