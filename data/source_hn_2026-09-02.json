    {
      "source": "hn",
      "title": "Show HN: Weedout – Safari extension that hides YouTube AI-labeled videos",
      "url": "https://masteranza.github.io/weedout/",
      "author": "masteranza",
      "external_id": "49528895",
      "summary": null,
      "why_read": null,
      "authors": [],
      "category": null,
      "published": "2026-09-01T22:06:57Z",
      "score": 157,
      "comments": 70,
      "hn_url": "https://news.ycombinator.com/item?id=49528895",
      "snippet": "I&#x27;m the developer. I built this because AI-generated conspiracy videos were getting out of control in my own YouTube feed. Weedout is a $1.99 Safari extension for macOS that removes videos YouTube labels “Made with AI” from feed, search, related videos, playlists and Shorts. It uses YouTube&#x27;s label rather than AI detection, runs locally, and does not catch unlabeled videos.<p>Source for developers who want to fork or build: <a href=\"https:&#x2F;&#x2F;github.com&#x2F;masteranza&#x2F;weedout-for-youtube\" rel=\"nofollow\">https:&#x2F;&#x2F;github.com&#x2F;masteranza&#x2F;weedout-for-youtube</a><p>Pull requests are not accepted; the repository is for independent forks.",
      "links": []
    },
