      "source": "hn",
      "title": "Show HN: Mason – a lightweight Postgres read-replica, built on columnar storage",
      "url": "https://masondata.ai/",
      "author": "tagspace",
      "external_id": "50630294",
      "summary": null,
      "why_read": null,
      "authors": [],
