#!/bin/sh
# Pre-push hook: run the same checks CI's lint job runs, so broken pushes
# are caught locally instead of on GitHub Actions.
set -e

echo "[pre-push] ruff check"
uv run ruff check .

echo "[pre-push] ruff format --check"
uv run ruff format --check .

echo "[pre-push] ty check"
uv run ty check

echo "[pre-push] pytest"
uv run pytest -q
